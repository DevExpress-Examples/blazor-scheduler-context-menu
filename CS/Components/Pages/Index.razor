@page "/"
@using System.Globalization
@using scheduler_menu.Data
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Welcome</PageTitle>

@{
    RenderFragment<DxSchedulerAppointmentView> appointmentTemplate = context => @<div class="card @context.Label?.BackgroundCssClass">
        <div @oncontextmenu="((e) => ShowAppointmentContextMenu(e, context.Appointment))">
            @context.Appointment.Subject
        </div>
    </div>;
}

<div @ref="SchedulerContainer">
<DxScheduler @ref="Scheduler" @bind-StartDate="StartDate" @bind-ActiveViewType="ActiveViewType"
             DataStorage="@DataStorage"
             GroupType="SchedulerGroupType.Resource"
             HtmlCellDecoration="OnHtmlCellDecoration"
             @bind-VisibleResourcesDataSource="@VisibleResources"
             CssClass="w-100">

    <DxSchedulerDayView DayCount="1" ShowWorkTimeOnly="@ShowWorkTimeOnly">
        <HorizontalAppointmentTemplate>
            @appointmentTemplate(context)
        </HorizontalAppointmentTemplate>
        <VerticalAppointmentTemplate>
            @appointmentTemplate(context)
        </VerticalAppointmentTemplate>
    </DxSchedulerDayView>

    <DxSchedulerWeekView ShowWorkTimeOnly="@ShowWorkTimeOnly">
        <HorizontalAppointmentTemplate>
            @appointmentTemplate(context)
        </HorizontalAppointmentTemplate>
        <VerticalAppointmentTemplate>
            @appointmentTemplate(context)
        </VerticalAppointmentTemplate>
    </DxSchedulerWeekView>

    <DxSchedulerWorkWeekView ShowWorkTimeOnly="@ShowWorkTimeOnly">
        <HorizontalAppointmentTemplate>
            @appointmentTemplate(context)
        </HorizontalAppointmentTemplate>
        <VerticalAppointmentTemplate>
            @appointmentTemplate(context)
        </VerticalAppointmentTemplate>
    </DxSchedulerWorkWeekView>

    <DxSchedulerMonthView ShowWorkDaysOnly="true" MonthCount="1">
        <HorizontalAppointmentTemplate>
            @appointmentTemplate(context)
        </HorizontalAppointmentTemplate>
    </DxSchedulerMonthView>

    <DxSchedulerTimelineView Duration="@TimeSpan.FromHours(48)" CellMinWidth="80">
        <Scales>
            <DxSchedulerTimeScale Unit="@SchedulerTimeScaleUnit.Day" UnitCount="1"></DxSchedulerTimeScale>
            <DxSchedulerTimeScale Unit="@SchedulerTimeScaleUnit.Hour" UnitCount="2"></DxSchedulerTimeScale>
        </Scales>
        <HorizontalAppointmentTemplate>
            @appointmentTemplate(context)
        </HorizontalAppointmentTemplate>
    </DxSchedulerTimelineView>

</DxScheduler>
</div>
<DxContextMenu @ref="@ContextMenu" ItemClick="@OnItemClick">
    <Items>
        <DxContextMenuItem Text="@ClickedRegion" Enabled="false" CssClass="fw-bold"></DxContextMenuItem>
        @switch (ClickedRegion)
        {
            case "Appointment":
                <DxContextMenuItem Text="Edit" Name="Edit" IconUrl="@GetMenuIcon("Edit")"></DxContextMenuItem>
                break;
            case "All Day Area":
                @if (ActiveViewType != SchedulerViewType.Day) {
                    <DxContextMenuItem Text="@OpenDayInDayViewText" Name="SwitchToDayView" IconUrl="@GetMenuIcon("SwitchToDayView")"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="@GoToTodayText" Name="GoToToday" IconUrl="@GetMenuIcon("GoToToday")"></DxContextMenuItem>
                break;
            case "Time Cell":
                <DxContextMenuItem Text="@GoToTodayText" Name="GoToToday" IconUrl="@GetMenuIcon("GoToToday")"></DxContextMenuItem>
                @if (ActiveViewType != SchedulerViewType.Day) {
                    <DxContextMenuItem Text="@OpenDayInDayViewText" Name="SwitchToDayView" IconUrl="@GetMenuIcon("SwitchToDayView")"></DxContextMenuItem>
                }
                break;
            case "Date Header":
                @if (ActiveViewType != SchedulerViewType.Day) {
                    <DxContextMenuItem Text="@OpenDayInDayViewText" Name="SwitchToDayView" IconUrl="@GetMenuIcon("SwitchToDayView")"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="@GoToTodayText" Name="GoToToday" IconUrl="@GetMenuIcon("GoToToday")"></DxContextMenuItem>
                break;
            case "Day of Week Header":
                <DxContextMenuItem Text="@GoToTodayText" Name="GoToToday" IconUrl="@GetMenuIcon("GoToToday")"></DxContextMenuItem>
                break;
            case "Resource Header":
                @if (VisibleResourcesTyped.Count() > 1) {
                    <DxContextMenuItem Text="Hide Resource" Name="HideResource" IconUrl="@GetMenuIcon("HideResource")"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="Show All Resources" Name="ShowAllResources" IconUrl="@GetMenuIcon("ShowAllResources")"></DxContextMenuItem>
                break;
            case "Time Ruler":
                <DxContextMenuItem Text="Toggle Work Time Only" Name="ToggleWorkTime" IconUrl="@GetMenuIcon("ToggleWorkTime")"></DxContextMenuItem>
                break;
            case "Toolbar":
                @if (ActiveViewType != SchedulerViewType.Day) {
                    <DxContextMenuItem Text="Switch to Day View" Name="SwitchToDayView" IconUrl="@GetMenuIcon("SwitchToDayView")"></DxContextMenuItem>
                }
                @if (ActiveViewType != SchedulerViewType.Week) {
                    <DxContextMenuItem Text="Switch to Week View" Name="SwitchToWeekView" IconUrl="@GetMenuIcon("SwitchToWeekView")"></DxContextMenuItem>
                }
                @if (ActiveViewType != SchedulerViewType.WorkWeek) {
                    <DxContextMenuItem Text="Switch to Work Week View" Name="SwitchToWorkWeekView" IconUrl="@GetMenuIcon("SwitchToWorkWeekView")"></DxContextMenuItem>
                }
                @if (ActiveViewType != SchedulerViewType.Month) {
                    <DxContextMenuItem Text="Switch to Month View" Name="SwitchToMonthView" IconUrl="@GetMenuIcon("SwitchToMonthView")"></DxContextMenuItem>
                }
                @if (ActiveViewType != SchedulerViewType.Timeline) {
                    <DxContextMenuItem Text="Switch to Timeline View" Name="SwitchToTimelineView" IconUrl="@GetMenuIcon("SwitchToTimelineView")"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="@GoToTodayText" Name="GoToToday" IconUrl="@GetMenuIcon("GoToToday")"></DxContextMenuItem>
                break;
        }
    </Items>
</DxContextMenu>
