@page "/"
@using System.Globalization
@using scheduler_menu.Data
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Welcome</PageTitle>

Selected appointment: @SelectedAppointment?.Subject

<div @ref="SchedulerContainer">
<DxScheduler @ref="Scheduler" @bind-StartDate="StartDate" @bind-ActiveViewType=MyActiveViewType
             @bind-SelectedAppointment="SelectedAppointment"
             DataStorage="@DataStorage"
             GroupType="SchedulerGroupType.Resource"
             HtmlCellDecoration="OnHtmlCellDecoration"
             VisibleResourcesDataSource="VisibleResources"
             CssClass="w-100">
    <DxSchedulerDayView DayCount="1" ShowWorkTimeOnly="@ShowWorkTimeOnly">
    </DxSchedulerDayView>
    <DxSchedulerWeekView ShowWorkTimeOnly="@ShowWorkTimeOnly">
    </DxSchedulerWeekView>
    <DxSchedulerWorkWeekView ShowWorkTimeOnly="@ShowWorkTimeOnly">
    </DxSchedulerWorkWeekView>
    <DxSchedulerMonthView ShowWorkDaysOnly="true" MonthCount="1">
    </DxSchedulerMonthView>
    <DxSchedulerTimelineView Duration="@TimeSpan.FromHours(48)" CellMinWidth="80">
        <Scales>
            <DxSchedulerTimeScale Unit="@SchedulerTimeScaleUnit.Day" UnitCount="1"></DxSchedulerTimeScale>
            <DxSchedulerTimeScale Unit="@SchedulerTimeScaleUnit.Hour" UnitCount="2"></DxSchedulerTimeScale>
        </Scales>
    </DxSchedulerTimelineView>
</DxScheduler>
</div>
<DxContextMenu @ref="@ContextMenu" ItemClick="@OnItemClick">
    <Items>
        <DxContextMenuItem Text="@_clickedRegion" Enabled="false" CssClass="fw-bold"></DxContextMenuItem>
        @switch (_clickedRegion)
        {
            case "Appointment":
                <DxContextMenuItem Text="Edit" Name="Edit"></DxContextMenuItem>
                break;
            case "All Day Area":
                <DxContextMenuItem Text="Clear all appointments for the day" Name="ClearAllDay"></DxContextMenuItem>
                <DxContextMenuItem Text="Go to Today" Name="GoToToday"></DxContextMenuItem>
                break;
            case "Time Cell":
                <DxContextMenuItem Text="Go to Today" Name="GoToToday"></DxContextMenuItem>
                break;
            case "Date Header":
                @if (MyActiveViewType != SchedulerViewType.Day) {
                    <DxContextMenuItem Text="Switch to Day View" Name="SwitchToDayView"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="Go to Today" Name="GoToToday"></DxContextMenuItem>
                break;
            case "Day of Week Header":
                <DxContextMenuItem Text="Go to Today" Name="GoToToday"></DxContextMenuItem>
                break;
            case "Resource Header":
                @if (SelectedAppointment is not null && VisibleResources.Count > 1) {
                    <DxContextMenuItem Text="Hide Resource of the selected Appointment" Name="HideResource"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="Show All Resources" Name="ShowAllResources"></DxContextMenuItem>
                break;
            case "Time Ruler":
                <DxContextMenuItem Text="Toggle Work Time Only" Name="ToggleWorkTime"></DxContextMenuItem>
                break;
            case "Toolbar":
                @if (MyActiveViewType != SchedulerViewType.Day) {
                    <DxContextMenuItem Text="Switch to Day View" Name="SwitchToDayView"></DxContextMenuItem>
                }
                @if (MyActiveViewType != SchedulerViewType.Week) {
                    <DxContextMenuItem Text="Switch to Week View" Name="SwitchToWeekView"></DxContextMenuItem>
                }
                @if (MyActiveViewType != SchedulerViewType.WorkWeek) {
                    <DxContextMenuItem Text="Switch to Work Week View" Name="SwitchToWorkWeekView"></DxContextMenuItem>
                }
                @if (MyActiveViewType != SchedulerViewType.Month) {
                    <DxContextMenuItem Text="Switch to Month View" Name="SwitchToMonthView"></DxContextMenuItem>
                }
                <DxContextMenuItem Text="Go to Today" Name="GoToToday"></DxContextMenuItem>
                break;
        }
    </Items>
</DxContextMenu>


@code {
    ElementReference SchedulerContainer;
    DotNetObjectReference<Index>? DotNetRef;
    IJSObjectReference? JsModule;
    DxScheduler? Scheduler;
    DateTime StartDate = DateTime.Today;
    DxSchedulerAppointmentItem? SelectedAppointment;
    bool ShowWorkTimeOnly = true;
    SchedulerViewType MyActiveViewType = SchedulerViewType.Day;
    DxContextMenu? ContextMenu { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            DotNetRef = DotNetObjectReference.Create(this);
            JsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/appointmentContextMenu.js");
            await JsModule.InvokeVoidAsync("setup", SchedulerContainer, DotNetRef);
        }
    }

    string _clickedRegion = string.Empty;

    [JSInvokable]
    public async Task ShowAppointmentContextMenu(double clientX, double clientY, double pageX, double pageY, string region) {
        _clickedRegion = region;
        // Force a re-render to ensure that the context menu label reflects the new region before the menu opens.
        StateHasChanged();
        await (ContextMenu?.ShowAsync(new Microsoft.AspNetCore.Components.Web.MouseEventArgs
        {
            ClientX = clientX,
            ClientY = clientY,
            PageX = pageX,
            PageY = pageY
        }) ?? Task.FromResult(false));
    }

    public async ValueTask DisposeAsync() {
        if (JsModule is not null)
            await JsModule.DisposeAsync();
        DotNetRef?.Dispose();
    }


    async void OnItemClick(ContextMenuItemClickEventArgs args) {
        switch (args.ItemInfo.Name)
        {
            case "Edit":
                if (Scheduler is not null && SelectedAppointment is not null)
                    await Scheduler.ShowAppointmentEditFormAsync(false, SelectedAppointment);
                break;
            case "ClearAllDay":
                if (Scheduler is not null) {
                    var range = new DxSchedulerDateTimeRange(StartDate.Date, StartDate.Date.AddDays(1));
                    var appointments = DataStorage.GetAppointments(range).ToList();
                    foreach (var apt in appointments) {
                        await Scheduler.DeleteAppointmentAsync(apt);
                        await Task.Delay(100); // Ensure the scheduler has time to process the deletions before refreshing the view
                    }
                }
                break;
            case "GoToToday":
                StartDate = DateTime.Today;
                break;
            case "SwitchToDayView":
                MyActiveViewType = SchedulerViewType.Day;
                break;
            case "SwitchToWeekView":
                MyActiveViewType = SchedulerViewType.Week;
                break;
            case "SwitchToWorkWeekView":
                MyActiveViewType = SchedulerViewType.WorkWeek;
                break;
            case "SwitchToMonthView":
                MyActiveViewType = SchedulerViewType.Month;
                break;
            case "HideResource":
                if (SelectedAppointment is not null) {
                    var resourceId = SelectedAppointment.ResourceId;
                    var resourceToHide = VisibleResources.FirstOrDefault(r => r.Id.Equals(resourceId));
                    if (resourceToHide is not null && VisibleResources.Count > 1)
                        VisibleResources = VisibleResources.Where(r => !r.Equals(resourceToHide)).ToList();
                }
                break;
            case "ShowAllResources":
                VisibleResources = ResourceCollection.GetResourcesForGrouping();
                break;
            case "ToggleWorkTime":
                ShowWorkTimeOnly = !ShowWorkTimeOnly;
                break;
        }
        StateHasChanged();
    }

    DxSchedulerDataStorage DataStorage = new DxSchedulerDataStorage() {
            AppointmentsSource = RecurringAppointmentCollection.GetAppointments(),
            AppointmentMappings = new DxSchedulerAppointmentMappings() {
                Id = "AppointmentID",
                Type = "AppointmentType",
                Start = "StartDate",
                End = "EndDate",
                Subject = "Caption",
                AllDay = "AllDay",
                Location = "Location",
                Description = "Description",
                LabelId = "Label",
                StatusId = "Status",
                RecurrenceInfo = "Recurrence",
                ResourceId = "ResourceId"
            },
            ResourcesSource = ResourceCollection.GetResourcesForGrouping(),
            ResourceMappings = new DxSchedulerResourceMappings() {
                Id = "Id",
                Caption = "Name",
                BackgroundCssClass = "BackgroundCss",
                TextCssClass = "TextCss"
            }
        };
    List<Resource> VisibleResources = ResourceCollection.GetResources().Take(2).ToList();
    private void OnHtmlCellDecoration(SchedulerHtmlCellDecorationEventArgs e)
    {
        switch(e.CellType)
        {
            case SchedulerCellType.DateHeader:
                e.CssClass = "custom-date-header";
                break;
            case SchedulerCellType.TimeCell:
                e.CssClass = "custom-time-cell";
                break;
            case SchedulerCellType.ResourceHeader:
                e.CssClass = "custom-resource-header";
                break;
            case SchedulerCellType.AllDayTimeCell:
                e.CssClass = "custom-all-date-time-cell";
                break;
            case SchedulerCellType.DayOfWeekHeader:
                e.CssClass = "custom-day-of-week-header";
                break;
            case SchedulerCellType.None:
                e.CssClass = "custom-none";
                break;
        }
    }
}